{
  "appId": "com.namao.delivery",
  "appName": "Delivery NaMão",
  "webDir": "src",
  "server": {
    "androidScheme": "https",
    "url": "https://entregador-namao.web.app",
    "cleartext": false,
    "errorPath": "error.html"
  },
  "plugins": {
    "BackgroundGeolocation": {
      "notificationTitle": "Delivery NaMão",
      "notificationText": "Rastreando sua entrega em andamento",
      "backgroundMessage": "NaMão está usando sua localização",
      "backgroundTitle": "Entrega ativa",
      "requestPermissions": true,
      "stale": false,
      "distanceFilter": 20
    },
    "Camera": {
      "permissions": ["camera", "photos"]
    }
  }
}
