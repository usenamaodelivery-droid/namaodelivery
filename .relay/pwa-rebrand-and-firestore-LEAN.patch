diff --git a/src/lib/firestore.ts b/src/lib/firestore.ts
new file mode 100644
index 0000000..af8dab4
--- /dev/null
+++ b/src/lib/firestore.ts
@@ -0,0 +1,62 @@
+/**
+ * Firestore Admin SDK adapter for Delivery NaMão PWA.
+ *
+ * The PWA writes orders straight to the production project
+ * (`namao-delivery-prod`) so the driver app reads them in real time.
+ *
+ * Required env var (set on Vercel as a single line of JSON):
+ *   FIREBASE_SERVICE_ACCOUNT_JSON  — the full JSON downloaded from
+ *     Firebase Console → Project Settings → Service accounts → Generate new
+ *     private key. The JSON is base64 SAFE — paste as-is into the env var.
+ *
+ * Falls back to in-memory mock when the var is missing so local dev still
+ * works without Firebase credentials.
+ */
+
+import { cert, getApp, getApps, initializeApp, type App, type ServiceAccount } from 'firebase-admin/app';
+import { getFirestore, type Firestore } from 'firebase-admin/firestore';
+
+let cachedDb: Firestore | null | undefined;
+
+const APP_ID = 'namao-delivery-prod';
+
+function readServiceAccount(): ServiceAccount | null {
+  const raw = process.env.FIREBASE_SERVICE_ACCOUNT_JSON;
+  if (!raw) return null;
+  try {
+    return JSON.parse(raw) as ServiceAccount;
+  } catch (err) {
+    console.error('[firestore] invalid FIREBASE_SERVICE_ACCOUNT_JSON:', err);
+    return null;
+  }
+}
+
+/** Returns the shared Firestore instance, or null if Firebase isn't configured. */
+export function getDb(): Firestore | null {
+  if (cachedDb !== undefined) return cachedDb;
+
+  const sa = readServiceAccount();
+  if (!sa) {
+    console.warn('[firestore] FIREBASE_SERVICE_ACCOUNT_JSON not set — falling back to mock store');
+    cachedDb = null;
+    return null;
+  }
+
+  let app: App;
+  if (getApps().length) {
+    app = getApp();
+  } else {
+    app = initializeApp({ credential: cert(sa) });
+  }
+  cachedDb = getFirestore(app);
+  return cachedDb;
+}
+
+/** Path of the orders collection on the shared backend. */
+export function ordersPath(): string {
+  return `artifacts/${APP_ID}/public/data/orders`;
+}
+
+export function isFirestoreEnabled(): boolean {
+  return getDb() !== null;
+}
diff --git a/src/lib/orderMapper.ts b/src/lib/orderMapper.ts
new file mode 100644
index 0000000..de5f4cb
--- /dev/null
+++ b/src/lib/orderMapper.ts
@@ -0,0 +1,167 @@
+/**
+ * Schema mapper between the PWA's Order shape and the driver app's
+ * Firestore schema.
+ *
+ * Driver schema fields used (see `namao-delivery/src/js/orders.js`):
+ *   veh: 'Moto' | 'Carro'
+ *   itemType: string
+ *   price: number  (R$)
+ *   origin: string  (formatted address)
+ *   destination: string  (formatted address)
+ *   originCoords: { lat, lng }
+ *   destCoords: { lat, lng }
+ *   status: 'waiting_confirmation' | 'pending' | 'accepted' | 'in_transit' | 'completed' | 'cancelled'
+ *   customerId: string
+ *   driverId: string | null
+ *   driverName: string | null
+ *   driverLat / driverLng: number | null
+ *   createdAt: number
+ *   pickupPhotoUrl, podPhotoUrl, podSignatureUrl: string
+ */
+
+import type { Order, OrderStatus } from './store';
+
+/** PWA → Driver schema status map. */
+export function pwaStatusToDriver(s: OrderStatus): string {
+  switch (s) {
+    case 'awaiting_payment': return 'waiting_confirmation';
+    case 'searching':        return 'pending';
+    case 'accepted':         return 'accepted';
+    case 'picking_up':       return 'accepted';
+    case 'in_transit':       return 'in_transit';
+    case 'delivered':        return 'completed';
+    case 'cancelled':        return 'cancelled';
+  }
+}
+
+/** Driver → PWA schema status map. */
+export function driverStatusToPwa(s: string): OrderStatus {
+  switch (s) {
+    case 'waiting_confirmation': return 'awaiting_payment';
+    case 'pending':              return 'searching';
+    case 'accepted':             return 'accepted';
+    case 'in_transit':           return 'in_transit';
+    case 'completed':            return 'delivered';
+    case 'cancelled':            return 'cancelled';
+    default:                     return 'searching';
+  }
+}
+
+/** Heuristic: choose vehicle from item type / weight. */
+export function defaultVehicleFor(itemType: Order['itemType']): 'Moto' | 'Carro' {
+  if (itemType === 'caixa-grande') return 'Carro';
+  return 'Moto';
+}
+
+/** Builds a one-line formatted address (rua, nº, complemento — bairro · cidade-UF · CEP). */
+export function formatAddressLine(addr: Order['origin']): string {
+  const parts: string[] = [];
+  const street = addr.formatted || '';
+  parts.push(street);
+  if (addr.numero) parts[parts.length - 1] = `${street}, ${addr.numero}`;
+  if (addr.complemento) parts.push(addr.complemento);
+  return parts.filter(Boolean).join(' — ');
+}
+
+/** Convert a PWA order into the doc shape the driver app expects. */
+export function pwaOrderToDriverDoc(o: Order, customerId: string) {
+  const vehicle = defaultVehicleFor(o.itemType);
+  return {
+    veh: vehicle,
+    itemType: itemTypeToLabel(o.itemType),
+    price: o.priceCents / 100,
+    origin: formatAddressLine(o.origin),
+    destination: formatAddressLine(o.destination),
+    originCoords: { lat: o.origin.lat, lng: o.origin.lng },
+    destCoords: { lat: o.destination.lat, lng: o.destination.lng },
+    originRef: o.origin.referencia ?? null,
+    destRef: o.destination.referencia ?? null,
+    distanceKm: o.distanceKm,
+    durationMin: o.durationMin,
+    status: pwaStatusToDriver(o.status),
+    customerId,
+    customerName: o.customerName,
+    customerPhone: o.customerPhone,
+    driverId: null,
+    driverName: null,
+    driverLat: null,
+    driverLng: null,
+    createdAt: o.createdAt,
+    pixPayload: o.pixPayload ?? null,
+    pixQrDataUrl: o.pixQrDataUrl ?? null,
+    ref: o.ref ?? null,
+  };
+}
+
+/** Convert a driver Firestore doc back into a PWA Order (for /acompanhar). */
+export function driverDocToPwaOrder(id: string, d: Record<string, unknown>): Order {
+  const originCoords = (d.originCoords ?? {}) as { lat?: number; lng?: number };
+  const destCoords = (d.destCoords ?? {}) as { lat?: number; lng?: number };
+  const driverInfo = d.driverId
+    ? {
+        name: String(d.driverName ?? 'Motorista'),
+        rating: 5,
+        vehicle: (d.veh === 'Carro' ? 'carro' : 'moto') as 'moto' | 'carro',
+        plate: '—',
+        lat: Number(d.driverLat ?? originCoords.lat ?? 0),
+        lng: Number(d.driverLng ?? originCoords.lng ?? 0),
+        etaMin: Number(d.durationMin ?? 10),
+      }
+    : undefined;
+
+  return {
+    id,
+    createdAt: Number(d.createdAt ?? Date.now()),
+    paidAt: d.pixConfirmedAt ? Number(d.pixConfirmedAt) : undefined,
+    customerName: String(d.customerName ?? ''),
+    customerPhone: String(d.customerPhone ?? ''),
+    origin: {
+      cep: '',
+      formatted: String(d.origin ?? ''),
+      lat: Number(originCoords.lat ?? 0),
+      lng: Number(originCoords.lng ?? 0),
+      referencia: d.originRef ? String(d.originRef) : undefined,
+    },
+    destination: {
+      cep: '',
+      formatted: String(d.destination ?? ''),
+      lat: Number(destCoords.lat ?? 0),
+      lng: Number(destCoords.lng ?? 0),
+      referencia: d.destRef ? String(d.destRef) : undefined,
+    },
+    itemType: labelToItemType(String(d.itemType ?? 'Comida')),
+    distanceKm: Number(d.distanceKm ?? 0),
+    durationMin: Number(d.durationMin ?? 0),
+    priceCents: Math.round(Number(d.price ?? 0) * 100),
+    status: driverStatusToPwa(String(d.status ?? 'pending')),
+    pixPayload: d.pixPayload ? String(d.pixPayload) : undefined,
+    pixQrDataUrl: d.pixQrDataUrl ? String(d.pixQrDataUrl) : undefined,
+    driver: driverInfo,
+    pod: d.podPhotoUrl
+      ? {
+          photoUrl: String(d.podPhotoUrl),
+          signatureDataUrl: d.podSignatureUrl ? String(d.podSignatureUrl) : undefined,
+          completedAt: d.completedAt ? Number(d.completedAt) : undefined,
+        }
+      : undefined,
+    ref: d.ref ? String(d.ref) : undefined,
+  };
+}
+
+const ITEM_LABELS: Record<Order['itemType'], string> = {
+  documento: 'Documento',
+  'caixa-pequena': 'Caixa pequena',
+  'caixa-grande': 'Caixa grande',
+  fragil: 'Frágil',
+  comida: 'Comida',
+};
+
+function itemTypeToLabel(t: Order['itemType']): string {
+  return ITEM_LABELS[t] ?? 'Outros';
+}
+
+function labelToItemType(label: string): Order['itemType'] {
+  const found = (Object.entries(ITEM_LABELS) as [Order['itemType'], string][])
+    .find(([, l]) => l === label);
+  return found ? found[0] : 'comida';
+}
