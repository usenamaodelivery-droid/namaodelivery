@@ -0,0 +1,158 @@
+'use client';
+
+import { useEffect, useState } from 'react';
+import type { Order, OrderStatus } from '@/lib/store';
+
+const STATUS_MAP: Record<OrderStatus, { label: string; emoji: string; tone: string }> = {
+  awaiting_payment: { label: 'Aguardando PIX',              emoji: '💳', tone: 'bg-yellow-100 text-yellow-800' },
+  searching:        { label: 'Procurando motorista',         emoji: '🔍', tone: 'bg-blue-100 text-blue-700'     },
+  accepted:         { label: 'Motorista a caminho da coleta',emoji: '🛵', tone: 'bg-indigo-100 text-indigo-700' },
+  picking_up:       { label: 'Coletando',                    emoji: '📦', tone: 'bg-indigo-100 text-indigo-700' },
+  in_transit:       { label: 'A caminho do destino',         emoji: '🚚', tone: 'bg-amber-100 text-amber-800'   },
+  delivered:        { label: 'Entregue',                     emoji: '✅', tone: 'bg-green-100 text-green-700'   },
+  cancelled:        { label: 'Cancelado',                    emoji: '❌', tone: 'bg-red-100 text-red-700'       },
+};
+
+function brl(cents: number) {
+  return (cents / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
+}
+
+function relTime(ts: number) {
+  const d = Date.now() - ts;
+  if (d < 60_000) return 'há poucos segundos';
+  if (d < 3_600_000) return `há ${Math.floor(d / 60_000)} min`;
+  if (d < 86_400_000) return `há ${Math.floor(d / 3_600_000)} h`;
+  return new Date(ts).toLocaleDateString('pt-BR');
+}
+
+export function OrdersList() {
+  const [ids, setIds] = useState<string[] | null>(null);
+  const [orders, setOrders] = useState<Map<string, Order>>(new Map());
+  const [loading, setLoading] = useState(true);
+
+  useEffect(() => {
+    if (typeof window === 'undefined') return;
+    try {
+      const raw = localStorage.getItem('namao_orders');
+      const list: string[] = raw ? JSON.parse(raw) : [];
+      setIds(Array.isArray(list) ? list : []);
+    } catch {
+      setIds([]);
+    }
+  }, []);
+
+  useEffect(() => {
+    if (!ids || ids.length === 0) {
+      setLoading(false);
+      return;
+    }
+    let live = true;
+    const tick = async () => {
+      const next = new Map<string, Order>();
+      await Promise.all(
+        ids.map(async (id) => {
+          try {
+            const r = await fetch(`/api/orders/${id}`);
+            if (r.ok) next.set(id, await r.json());
+          } catch { /* ignore */ }
+        }),
+      );
+      if (live) {
+        setOrders(next);
+        setLoading(false);
+      }
+    };
+    tick();
+    const t = setInterval(tick, 8_000);
+    return () => { live = false; clearInterval(t); };
+  }, [ids]);
+
+  const clearFinished = () => {
+    if (!ids) return;
+    const active = ids.filter((id) => {
+      const o = orders.get(id);
+      return o && o.status !== 'delivered' && o.status !== 'cancelled';
+    });
+    localStorage.setItem('namao_orders', JSON.stringify(active));
+    setIds(active);
+  };
+
+  if (loading && ids && ids.length > 0) {
+    return <div className="p-8 text-center text-gray-500">Carregando pedidos…</div>;
+  }
+
+  if (!ids || ids.length === 0) {
+    return (
+      <div className="flex-1 flex flex-col items-center justify-center px-6 py-16 text-center">
+        <div className="text-6xl mb-3">📦</div>
+        <div className="font-black text-lg text-[color:var(--color-navy)] mb-1">
+          Nenhum pedido por aqui ainda
+        </div>
+        <div className="text-sm text-gray-600 max-w-xs mb-6">
+          Quando você fizer um pedido, ele aparece aqui pra você acompanhar a qualquer hora.
+        </div>
+        <a href="/pedir" className="btn btn-primary">Fazer meu primeiro pedido</a>
+      </div>
+    );
+  }
+
+  const sorted = Array.from(orders.values()).sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
+  const hasFinished = sorted.some((o) => o.status === 'delivered' || o.status === 'cancelled');
+
+  return (
+    <div className="max-w-3xl w-full mx-auto px-5 py-5 flex-1 flex flex-col gap-3">
+      <div className="flex items-center justify-between px-1">
+        <h1 className="font-black text-xl text-[color:var(--color-navy)]">Meus pedidos</h1>
+        {hasFinished && (
+          <button onClick={clearFinished} className="text-xs text-gray-500 underline">
+            Limpar entregues
+          </button>
+        )}
+      </div>
+
+      {sorted.map((o) => {
+        const s = STATUS_MAP[o.status];
+        const active = o.status !== 'delivered' && o.status !== 'cancelled';
+        return (
+          <a
+            key={o.id}
+            href={`/acompanhar/${o.id}`}
+            className="card p-4 flex items-start gap-3 active:scale-[0.995] transition"
+          >
+            <div className="text-3xl">{s.emoji}</div>
+            <div className="flex-1 min-w-0">
+              <div className="flex items-center gap-2 flex-wrap">
+                <span className={`text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full ${s.tone}`}>
+                  {s.label}
+                </span>
+                {active && (
+                  <span className="inline-flex items-center gap-1 text-[10px] font-bold text-[color:var(--color-gold-dark)]">
+                    <span className="w-1.5 h-1.5 rounded-full bg-[color:var(--color-gold)] animate-pulse" />
+                    Ao vivo
+                  </span>
+                )}
+              </div>
+              <div className="mt-1 text-sm font-semibold text-[color:var(--color-navy)] truncate">
+                {o.destination?.formatted || 'Destino'}
+              </div>
+              <div className="text-xs text-gray-500 truncate">
+                De {o.origin?.formatted || 'origem'}
+              </div>
+              <div className="flex items-center justify-between mt-1.5">
+                <span className="text-[11px] text-gray-400">{relTime(o.createdAt)}</span>
+                <span className="font-black text-[color:var(--color-navy)] text-sm">{brl(o.priceCents)}</span>
+              </div>
+            </div>
+          </a>
+        );
+      })}
+
+      {/* Mostra ids sem dados (pode ter sido deletado do Firestore) */}
+      {ids.filter((id) => !orders.has(id)).map((id) => (
+        <div key={id} className="card p-3 text-xs text-gray-400">
+          Pedido <b>{id}</b> — não encontrado.
+        </div>
+      ))}
+    </div>
+  );
+}
