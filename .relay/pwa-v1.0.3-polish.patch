diff --git a/src/app/acompanhar/[orderId]/ChatBox.tsx b/src/app/acompanhar/[orderId]/ChatBox.tsx
new file mode 100644
index 0000000..93e9093
--- /dev/null
+++ b/src/app/acompanhar/[orderId]/ChatBox.tsx
@@ -0,0 +1,147 @@
+'use client';
+
+import { useEffect, useRef, useState } from 'react';
+
+export interface ChatMessage {
+  id: string;
+  orderId: string;
+  from: 'customer' | 'driver';
+  text: string;
+  at: number;
+}
+
+type Role = 'customer' | 'driver';
+
+export function ChatBox({ orderId, role }: { orderId: string; role: Role }) {
+  const [messages, setMessages] = useState<ChatMessage[]>([]);
+  const [text, setText] = useState('');
+  const [sending, setSending] = useState(false);
+  const listRef = useRef<HTMLDivElement | null>(null);
+  const lastCountRef = useRef(0);
+
+  useEffect(() => {
+    let live = true;
+    const tick = async () => {
+      try {
+        const r = await fetch(`/api/orders/${orderId}/messages`);
+        if (!r.ok) return;
+        const data = (await r.json()) as { messages: ChatMessage[] };
+        if (!live) return;
+        const list = Array.isArray(data.messages) ? data.messages : [];
+        setMessages(list);
+
+        // Beep curto quando chega mensagem nova do outro lado
+        if (list.length > lastCountRef.current) {
+          const last = list[list.length - 1];
+          if (last && last.from !== role && lastCountRef.current > 0) {
+            try {
+              const Ctx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
+              const ctx = new Ctx();
+              const o = ctx.createOscillator();
+              const g = ctx.createGain();
+              o.frequency.value = 720;
+              g.gain.setValueAtTime(0.0001, ctx.currentTime);
+              g.gain.exponentialRampToValueAtTime(0.2, ctx.currentTime + 0.02);
+              g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.25);
+              o.connect(g).connect(ctx.destination);
+              o.start();
+              o.stop(ctx.currentTime + 0.28);
+            } catch { /* ignore */ }
+          }
+        }
+        lastCountRef.current = list.length;
+      } catch { /* ignore */ }
+    };
+    tick();
+    const t = setInterval(tick, 3_000);
+    return () => { live = false; clearInterval(t); };
+  }, [orderId, role]);
+
+  useEffect(() => {
+    if (listRef.current) {
+      listRef.current.scrollTop = listRef.current.scrollHeight;
+    }
+  }, [messages.length]);
+
+  const send = async () => {
+    const body = text.trim();
+    if (!body || sending) return;
+    setSending(true);
+    try {
+      const r = await fetch(`/api/orders/${orderId}/messages`, {
+        method: 'POST',
+        headers: { 'content-type': 'application/json' },
+        body: JSON.stringify({ from: role, text: body }),
+      });
+      if (r.ok) {
+        setText('');
+        const data = (await r.json()) as { messages: ChatMessage[] };
+        if (Array.isArray(data.messages)) setMessages(data.messages);
+      }
+    } finally {
+      setSending(false);
+    }
+  };
+
+  return (
+    <div className="card p-4 flex flex-col gap-2">
+      <div className="flex items-center justify-between">
+        <div className="text-xs font-bold text-gray-500 uppercase tracking-wider">
+          💬 Chat com o motorista
+        </div>
+        <span className="text-[10px] text-gray-400">mensagens privadas no app</span>
+      </div>
+
+      <div
+        ref={listRef}
+        className="bg-gray-50 rounded-xl p-3 flex flex-col gap-2 max-h-56 overflow-y-auto"
+      >
+        {messages.length === 0 && (
+          <div className="text-xs text-gray-400 text-center py-3">
+            Nenhuma mensagem ainda. Mande um oi 👋
+          </div>
+        )}
+        {messages.map((m) => {
+          const mine = m.from === role;
+          return (
+            <div
+              key={m.id}
+              className={`flex ${mine ? 'justify-end' : 'justify-start'}`}
+            >
+              <div
+                className={`max-w-[85%] rounded-2xl px-3 py-1.5 text-sm ${
+                  mine
+                    ? 'bg-[color:var(--color-navy)] text-white rounded-br-sm'
+                    : 'bg-white border border-gray-200 text-gray-800 rounded-bl-sm'
+                }`}
+              >
+                <div className="whitespace-pre-wrap break-words">{m.text}</div>
+                <div className={`text-[10px] mt-0.5 ${mine ? 'text-white/70' : 'text-gray-400'}`}>
+                  {new Date(m.at).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })}
+                </div>
+              </div>
+            </div>
+          );
+        })}
+      </div>
+
+      <div className="flex gap-2">
+        <input
+          className="input flex-1"
+          value={text}
+          onChange={(e) => setText(e.target.value.slice(0, 500))}
+          onKeyDown={(e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); } }}
+          placeholder="Mensagem…"
+          maxLength={500}
+        />
+        <button
+          onClick={send}
+          disabled={!text.trim() || sending}
+          className="btn btn-primary !py-2 !px-4 !text-sm"
+        >
+          {sending ? '…' : 'Enviar'}
+        </button>
+      </div>
+    </div>
+  );
+}
