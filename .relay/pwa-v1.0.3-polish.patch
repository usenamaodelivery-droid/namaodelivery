diff --git a/src/lib/chatStore.ts b/src/lib/chatStore.ts
new file mode 100644
index 0000000..6874b2f
--- /dev/null
+++ b/src/lib/chatStore.ts
@@ -0,0 +1,76 @@
+/**
+ * Chat store for in-app client ↔ driver communication.
+ *
+ * Uses the same Firestore backend as orders, persisting messages in a
+ * subcollection at `artifacts/{appId}/public/data/orders/{id}/messages`.
+ *
+ * Falls back to an in-memory map when Firestore isn't configured so local
+ * dev still works.
+ */
+
+import { getDb, ordersPath } from './firestore';
+
+export interface ChatMessage {
+  id: string;
+  orderId: string;
+  from: 'customer' | 'driver';
+  text: string;
+  at: number;
+}
+
+declare global {
+  // eslint-disable-next-line no-var
+  var __namaoChat: Map<string, ChatMessage[]> | undefined;
+}
+
+function mockBucket(): Map<string, ChatMessage[]> {
+  if (!globalThis.__namaoChat) globalThis.__namaoChat = new Map();
+  return globalThis.__namaoChat;
+}
+
+function messagesPath(orderId: string): string {
+  return `${ordersPath()}/${orderId}/messages`;
+}
+
+function makeId(): string {
+  return `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`;
+}
+
+export async function listMessages(orderId: string): Promise<ChatMessage[]> {
+  const db = getDb();
+  if (!db) {
+    return (mockBucket().get(orderId) || []).slice().sort((a, b) => a.at - b.at);
+  }
+  const snap = await db.collection(messagesPath(orderId)).orderBy('at', 'asc').limit(200).get();
+  return snap.docs.map((d) => {
+    const data = d.data() as Omit<ChatMessage, 'id'>;
+    return { ...data, id: d.id };
+  });
+}
+
+export async function appendMessage(
+  orderId: string,
+  msg: Omit<ChatMessage, 'id' | 'orderId' | 'at'> & { at?: number },
+): Promise<ChatMessage> {
+  const full: ChatMessage = {
+    id: makeId(),
+    orderId,
+    from: msg.from,
+    text: msg.text,
+    at: msg.at ?? Date.now(),
+  };
+  const db = getDb();
+  if (!db) {
+    const list = mockBucket().get(orderId) || [];
+    list.push(full);
+    mockBucket().set(orderId, list);
+    return full;
+  }
+  await db.collection(messagesPath(orderId)).doc(full.id).set({
+    orderId: full.orderId,
+    from: full.from,
+    text: full.text,
+    at: full.at,
+  });
+  return full;
+}
