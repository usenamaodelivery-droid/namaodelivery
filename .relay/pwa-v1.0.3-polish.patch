+            <span className="font-black text-lg tracking-tight text-[color:var(--color-navy)]">
+              Na<span className="text-[color:var(--color-gold)]">Mão</span>
+            </span>
+          </a>
+          <a href="/pedir" className="text-xs font-bold text-[color:var(--color-navy)] underline">
+            + Novo pedido
+          </a>
+        </div>
+      </header>
+
+      <OrdersList />
+    </main>
+  );
+}
