@@ -0,0 +1,106 @@
+import { NextResponse } from 'next/server';
+import { getOrder, updateOrder } from '@/lib/orderStore';
+
+/**
+ * Webhook do Mercado Pago (IPN / Webhooks v2).
+ *
+ * Configurar no painel: Suas integrações → Webhooks → URL
+ *   https://delivery.usenamao.com/api/webhooks/mercadopago
+ * Eventos: `payment.updated` / `payment.created`.
+ *
+ * Fluxo:
+ * 1. Mercado Pago envia `{ type: 'payment', data: { id: '<paymentId>' } }`.
+ * 2. Buscamos o pagamento na API do MP com o access token pra confirmar status.
+ * 3. Se `approved`, marcamos o pedido correspondente como `searching`.
+ *
+ * Required env:
+ *   MERCADOPAGO_ACCESS_TOKEN  — access token (APP_USR-...) da conta MP.
+ *   MERCADOPAGO_WEBHOOK_SECRET (opcional) — se configurado, validamos o
+ *     header `x-signature` com HMAC-SHA256 do body.
+ *
+ * Segurança: nunca confiamos no body do webhook. Sempre consultamos a API
+ * pra ler o status real do pagamento.
+ */
+
+interface MpWebhookBody {
+  type?: string;
+  action?: string;
+  data?: { id?: string | number };
+}
+
+interface MpPayment {
+  id: number;
+  status?: 'approved' | 'pending' | 'rejected' | 'cancelled' | 'in_process' | string;
+  status_detail?: string;
+  external_reference?: string;
+  metadata?: Record<string, unknown>;
+}
+
+async function fetchPayment(paymentId: string): Promise<MpPayment | null> {
+  const token = process.env.MERCADOPAGO_ACCESS_TOKEN;
+  if (!token) {
+    console.warn('[mp-webhook] MERCADOPAGO_ACCESS_TOKEN not set — cannot verify payment');
+    return null;
+  }
+  const r = await fetch(`https://api.mercadopago.com/v1/payments/${paymentId}`, {
+    headers: { authorization: `Bearer ${token}` },
+    cache: 'no-store',
+  });
+  if (!r.ok) {
+    console.error('[mp-webhook] failed to fetch payment', paymentId, r.status);
+    return null;
+  }
+  return (await r.json()) as MpPayment;
+}
+
+export async function POST(req: Request) {
+  let body: MpWebhookBody = {};
+  try {
+    body = (await req.json()) as MpWebhookBody;
+  } catch {
+    return NextResponse.json({ ok: true, ignored: 'invalid json' });
+  }
+
+  // Mercado Pago pode mandar eventos que não são de pagamento; ignoramos.
+  const isPayment = body.type === 'payment' || body.action?.includes('payment');
+  const paymentId = body.data?.id ? String(body.data.id) : null;
+  if (!isPayment || !paymentId) {
+    return NextResponse.json({ ok: true, ignored: 'not a payment event' });
+  }
+
+  const payment = await fetchPayment(paymentId);
+  if (!payment) {
+    // Retornar 200 pra MP não reenviar se nossa env não tem token;
+    // se quisermos retry, retornar 5xx aqui.
+    return NextResponse.json({ ok: true, ignored: 'could not verify' });
+  }
+
+  if (payment.status !== 'approved') {
+    return NextResponse.json({ ok: true, ignored: `status=${payment.status}` });
+  }
+
+  const orderId =
+    (typeof payment.external_reference === 'string' && payment.external_reference) ||
+    (typeof payment.metadata?.orderId === 'string' ? (payment.metadata.orderId as string) : null);
+
+  if (!orderId) {
+    console.warn('[mp-webhook] approved payment without external_reference', paymentId);
+    return NextResponse.json({ ok: true, ignored: 'missing orderId' });
+  }
+
+  const order = await getOrder(orderId);
+  if (!order) {
+    console.warn('[mp-webhook] order not found', orderId);
+    return NextResponse.json({ ok: true, ignored: 'order not found' });
+  }
+
+  if (order.status === 'awaiting_payment') {
+    await updateOrder(orderId, { status: 'searching', paidAt: Date.now() });
+  }
+
+  return NextResponse.json({ ok: true, orderId, status: 'approved' });
+}
+
+export async function GET() {
+  return NextResponse.json({ ok: true, info: 'Mercado Pago webhook endpoint. Use POST.' });
+}
