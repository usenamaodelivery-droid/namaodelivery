@@ -0,0 +1,33 @@
+import { NextResponse } from 'next/server';
+import { appendMessage, listMessages } from '@/lib/chatStore';
+import { getOrder } from '@/lib/orderStore';
+
+type Body = {
+  from?: 'customer' | 'driver';
+  text?: string;
+};
+
+export async function GET(_req: Request, ctx: RouteContext<'/api/orders/[id]/messages'>) {
+  const { id } = await ctx.params;
+  const order = await getOrder(id);
+  if (!order) return NextResponse.json({ error: 'not found' }, { status: 404 });
+  const messages = await listMessages(id);
+  return NextResponse.json({ messages });
+}
+
+export async function POST(req: Request, ctx: RouteContext<'/api/orders/[id]/messages'>) {
+  const { id } = await ctx.params;
+  const order = await getOrder(id);
+  if (!order) return NextResponse.json({ error: 'not found' }, { status: 404 });
+
+  const body = (await req.json().catch(() => ({}))) as Body;
+  const from = body.from === 'driver' ? 'driver' : body.from === 'customer' ? 'customer' : null;
+  const text = typeof body.text === 'string' ? body.text.trim().slice(0, 500) : '';
+  if (!from || !text) {
+    return NextResponse.json({ error: 'missing from/text' }, { status: 400 });
+  }
+
+  await appendMessage(id, { from, text });
+  const messages = await listMessages(id);
+  return NextResponse.json({ messages });
+}
