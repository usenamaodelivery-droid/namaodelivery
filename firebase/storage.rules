rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // POD: foto + assinatura do motorista
    match /artifacts/namao-delivery-prod/pod/{orderId}/{fileName} {
      // Leitura: cliente do pedido, motorista responsável ou admin.
      // A checagem cruzada precisa de firestore.get() — fazemos get() no pedido
      // para validar identidade.
      allow read: if request.auth != null && (
        request.auth.token.admin == true ||
        firestore.get(/databases/(default)/documents/artifacts/namao-delivery-prod/public/data/orders/$(orderId)).data.driverId == request.auth.uid ||
        firestore.get(/databases/(default)/documents/artifacts/namao-delivery-prod/public/data/orders/$(orderId)).data.customerId == request.auth.uid
      );

      // Escrita: apenas motorista responsável pelo pedido, arquivo <=8MB,
      // content-type image/*.
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/artifacts/namao-delivery-prod/public/data/orders/$(orderId)).data.driverId == request.auth.uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Avatar/documentos do motorista (upload opcional em futura feature)
    match /artifacts/namao-delivery-prod/users/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
